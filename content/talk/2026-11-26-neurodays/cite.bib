@inproceedings{2026-11-26-neurodays,
 abstract = {Art and neuroscience share a common object: perception. Artists have long exploited, often intuitively, the regularities and the limits of our visual system, from the colour contrasts of the Impressionists to the illusory motion of Op Art. Conversely, vision science has borrowed from art the stimuli that best reveal how the brain constructs what we see. As an introduction to this session, I will review this two-way dialogue from the perspective of computational neuroscience. Starting from visual illusions, I will show how perception can be understood as an active inference process, in which the brain combines noisy sensory evidence with prior expectations about the structure of natural scenes. I will then present fifteen years of collaboration with the visual artist Étienne Rey, in which installations based on light, motion and textures become genuine experimental devices, raising new questions about how we perceive emergence, instability and depth. Finally, at a time when artificial intelligence generates images at scale and blurs our relationship with reality, I will discuss what this dialogue between art and science teaches us about the specificity of biological vision, and the new avenues of research it opens in neuroscience.},
 author = {Perrinet, Laurent U},
 booktitle = {NeuroDays 2026: The Art of Neuroscience},
 date = {2026-11-26},
 location = {Aix-Marseille Université, Saint-Charles Campus, Marseille (France)},
 note = {Local chair},
 projects = {art-science},
 time_end = {2026-11-26T10:45:00},
 time_start = {2026-11-26T09:45:00},
 title = {Seeing through art: what artworks reveal about the mechanisms of vision},
 url = {https://neurodays2026.sciencesconf.org/resource/page/id/6},
 url_linkedin = {https://www.linkedin.com/posts/art-neuroscience-neurodays-share-7478527209096466433-mPA1/},
 year = {2026}
}
