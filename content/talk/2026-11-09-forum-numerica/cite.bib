@inproceedings{2026-11-09-forum-numerica,
 abstract = {Modelling working memory ---the ability to store and recall precise temporal patterns--- remains an open challenge in computational neuroscience. While recent advances evolved from Long Short-Term Memory networks to transformer architectures, which excel at linking long-range associations, these models deviate from biological plausibility: they are massive and energy-intensive. I will present our recent work on recurrent spiking neural networks (SNNs), inspired by the structure of information processing in biological systems. Based on the dynamics of realistic yet simple single-neuron models, our approach sheds light on fundamental neural phenomena, such as pattern formation in neural populations, the organization of high-dimensional brain activity, and traveling waves in sensory areas. It also demonstrates practical applications, including the production of gait patterns or the storage of textual information. This work aims to bridge the gap between biologically grounded models and scalable computational solutions, paving the way for more efficient and interpretable AI systems.},
 author = {Perrinet, Laurent U},
 booktitle = {Forum Numerica seminar series, Academy of Excellence "Networks, Information and Digital society", Université Côte d'Azur},
 date = {2026-11-09},
 location = {Room 007, i3S laboratory, Bâtiment Euclide B, Sophia Antipolis (France), and online (Zoom)},
 time_end = {2026-11-09T15:00:00},
 time_start = {2026-11-09T14:00:00},
 title = {Modelling memory to understand the brain},
 url = {https://ds4h.univ-cotedazur.eu/research-and-labs/forum-numerica-seminar-series/forum-numerica-laurent-perrinet-cnrs-aix-marseille-university-modelling-memory-to-understand-the-brain},
 year = {2026}
}
