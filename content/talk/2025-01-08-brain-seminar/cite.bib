@inproceedings{2025-01-08-brain-seminar,
 abstract = {The retinas of many animals, including humans, have a specialized area of high visual acuity called the fovea, while peripheral regions have lower resolution. This spatial organization, known as retinotopy, is important for biological vision, but is largely absent in machine learning. In our study, we investigate how retinotopy affects the performance of deep convolutional neural networks (CNNs) in image classification. By adding a retinotopic transformation to the input layer of standard ResNet models and retraining them, we achieve similar classification accuracy while improving the network's ability to handle zooms and rotations. The trade-off for this invariance is increased sensitivity to fixation point shifts. Consequently, the output probability at different gaze positions can be used as a cue to identify objects of interest. Overall, this study suggests why retinotopic mapping in foveated vision implements prior knowledge about visual object geometry, providing an efficient solution to the visual search problem, an essential function for predators.},
 author = {Perrinet, Laurent U},
 booktitle = {BRaIN Seminar,  CRN and McGill Vision Research},
 date = {2025-01-08},
 event_url = {https://www.mcgill.ca/crn/seminars},
 keywords = {deep learning,retinotopy,computational neuroscience,neuroai,eye movements},
 location = {CRN seminar room, Montreal General Hospital, Livingston Hall, L7-140, Montreal (Canada)},
 time_end = {2025-01-08T13:00:00},
 time_start = {2025-01-08T12:00:00},
 title = {How and why does retinotopy provides efficient vision},
 url = {https://laurentperrinet.github.io/talk/2025-01-08-brain-seminar},
 year = {2025}
}
