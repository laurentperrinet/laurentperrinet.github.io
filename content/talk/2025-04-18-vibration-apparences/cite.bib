@inproceedings{2025-04-18-vibration-apparences,
 abstract = {Le travail d’Etienne Rey met en lien des phénomènes naturels et physiques avec notre perception. Ses œuvres se révèlent et se concrétisent dans l’expérience personnelle des spectateurs. La lumière, élément central de sa démarche, active ces expériences, révélant les interactions entre le matériel et l’immatériel. Depuis 2011, Etienne Rey collabore avec le Dr. Laurent Perrinet de l’Institut de Neuroscience de la Timone. Ensemble, ils sondent le domaine de la perception à l’intersection de leurs disciplines respectives, combinant science et art pour développer de nouvelles approches perceptives.},
 author = {Perrinet, Laurent U},
 booktitle = {Journées d’Ouverture Scientifique (JOS)},
 date = {2025-04-18},
 location = {Marseille (France)},
 projects = {art-sciences},
 time_end = {2025-04-18T10:00:00},
 time_start = {2025-04-18T11:00:00},
 title = {La vibration des apparences},
 url = {https://laurentperrinet.github.io/talk/2025-04-18-vibration-apparences},
 year = {2025}
}
